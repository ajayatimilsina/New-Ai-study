<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Football Scores & Webcam Stream</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #1a1a1a; color: #fff; }
        header { background-color: #111; padding: 20px; text-align: center; border-bottom: 3px solid #2ecc71; }
        h1 { margin: 0; color: #2ecc71; }
        .container { display: flex; flex-wrap: wrap; padding: 20px; gap: 20px; max-width: 1400px; margin: 0 auto; }
        
        /* 1. Webcam Stream Section */
        .video-section { flex: 2; min-width: 450px; background: #222; padding: 15px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
        .video-container { position: relative; width: 100%; padding-bottom: 56.25%; /* 16:9 Aspect Ratio */ background: #000; border-radius: 6px; overflow: hidden; }
        .video-container video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); /* Mirrors webcam naturally */ }
        
        /* 2. Live Scores Section */
        .score-section { flex: 1; min-width: 320px; background: #222; padding: 15px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); height: 600px; overflow-y: auto; }
        .score-title { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #444; padding-bottom: 10px; margin-bottom: 15px; }
        .refresh-btn { background: #2ecc71; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; }
        .refresh-btn:hover { background: #27ae60; }
        
        /* Match Card Style */
        .match-card { background: #333; padding: 12px; margin-bottom: 10px; border-radius: 6px; border-left: 4px solid #2ecc71; display: flex; justify-content: space-between; align-items: center; }
        .teams { flex: 2; }
        .team-name { font-weight: bold; margin: 4px 0; font-size: 14px; }
        .scores { flex: 1; text-align: right; font-size: 18px; font-weight: bold; color: #f1c40f; }
        .match-status { font-size: 11px; background: #444; padding: 2px 6px; border-radius: 10px; color: #ccc; display: inline-block; margin-bottom: 5px; }
        .status-live { background: #e74c3c; color: white; animation: blink 1.5s infinite; }
        
        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
    </style>
</head>
<body>

    <header>
        <h1>Live Football Broadcast & Scores</h1>
        <p>Webcam Stream ra API key use garera real-time score herne thau</p>
    </header>

    <div class="container">
        <div class="video-section">
            <h2>🔴 My Webcam (Live Feed)</h2>
            <div class="video-container">
                <video id="webcam" autoplay playsinline></video>
            </div>
            <p id="cam-status" style="color: #aaa; margin-top: 10px; font-size: 14px;">
                Connecting to camera... Please allow browser permission.
            </p>
        </div>

        <div class="score-section">
            <div class="score-title">
                <h2>🏆 Match Scores</h2>
                <button class="refresh-btn" onclick="fetchScores()">Refresh</button>
            </div>
            <div id="api-status" style="color: #f1c40f; font-size: 12px; margin-bottom: 10px;">API Loading...</div>
            <div id="match-list"></div>
        </div>
    </div>

    <script>
        // --- 1. WEBCAM INITIALIZATION ---
        async function startWebcam() {
            const videoEl = document.getElementById('webcam');
            const camStatus = document.getElementById('cam-status');
            
            try {
                // Request camera permission
                const stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { width: 1280, height: 720 }, 
                    audio: false // Set to true if you want to capture microphone input
                });
                videoEl.srcObject = stream;
                camStatus.innerHTML = "🟢 Webcam status: Active";
                camStatus.style.color = "#2ecc71";
            } catch (error) {
                console.error("Error accessing webcam:", error);
                camStatus.innerHTML = "❌ Camera Access Denied or Not Found.";
                camStatus.style.color = "#e74c3c";
            }
        }

        // --- 2. API CONFIGURATION ---
        const API_KEY = "YOUR_FOOTBALL_DATA_API_KEY_HERE"; 
        const API_URL = "https://api.football-data.org/v4/matches"; 

        async function fetchScores() {
            const statusDiv = document.getElementById('api-status');
            
            if (API_KEY === "YOUR_FOOTBALL_DATA_API_KEY_HERE") {
                statusDiv.innerHTML = "⚠️ Please set your API Key in the code!";
                showMockData();
                return;
            }

            statusDiv.innerHTML = "Fetching latest data...";

            try {
                const response = await fetch(API_URL, {
                    headers: { 'X-Auth-Token': API_KEY }
                });
                
                if (!response.ok) throw new Error("API request failed");
                
                const data = await response.json();
                statusDiv.innerHTML = "Updated: " + new Date().toLocaleTimeString();
                displayMatches(data.matches);
            } catch (error) {
                console.error(error);
                statusDiv.innerHTML = "Error loading data. Showing offline data.";
                showMockData();
            }
        }

        function displayMatches(matches) {
            const matchList = document.getElementById('match-list');
            matchList.innerHTML = "";

            if (!matches || matches.length === 0) {
                matchList.innerHTML = "<p>No matches scheduled today.</p>";
                return;
            }

            matches.slice(0, 12).forEach(match => {
                const isLive = match.status === "IN_PLAY" || match.status === "PAUSED";
                const statusClass = isLive ? "match-status status-live" : "match-status";
                const statusText = isLive ? "🔴 LIVE" : match.status;

                const card = `
                    <div class="match-card">
                        <div class="teams">
                            <span class="${statusClass}">${statusText}</span>
                            <div class="team-name">⚽ ${match.homeTeam.name}</div>
                            <div class="team-name">⚽ ${match.awayTeam.name}</div>
                        </div>
                        <div class="scores">
                            <div>${match.score.fullTime.home !== null ? match.score.fullTime.home : 0}</div>
                            <div>${match.score.fullTime.away !== null ? match.score.fullTime.away : 0}</div>
                        </div>
                    </div>
                `;
                matchList.innerHTML += card;
            });
        }

        function showMockData() {
            const demoMatches = [
                {
                    status: "IN_PLAY",
                    homeTeam: { name: "Mexico 🇲🇽" },
                    awayTeam: { name: "South Africa 🇿🇦" },
                    score: { fullTime: { home: 1, away: 0 } }
                },
                {
                    status: "TIMED",
                    homeTeam: { name: "Japan 🇯🇵" },
                    awayTeam: { name: "Netherlands 🇳🇱" },
                    score: { fullTime: { home: 0, away: 0 } }
                },
                {
                    status: "FINISHED",
                    homeTeam: { name: "South Korea 🇰🇷" },
                    awayTeam: { name: "Czech Republic 🇨🇿" },
                    score: { fullTime: { home: 2, away: 1 } }
                }
            ];
            displayMatches(demoMatches);
        }

        // Start everything on load
        startWebcam();
        fetchScores();
        setInterval(fetchScores, 60000);
    </script>
</body>
</html>
